rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The Google account(s) that own this site and can sign in to admin.html
    function isOwner() {
      return request.auth != null && request.auth.token.email in ["wumeihui.lily@gmail.com", "wulily@usc.edu"];
    }

    // Master data: owner only
    match /admin/{docId} {
      allow read, write: if isOwner();
    }

    // One page per professor, named by a long random token.
    // Anyone with the exact link can open that one page; nobody but the owner can list them.
    // Professors can only change the checkmarks, nothing else.
    match /pages/{token} {
      allow get: if true;
      allow list, create, delete: if isOwner();
      allow update: if isOwner() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusAt'])
        && request.resource.data.status.keys().hasOnly(resource.data.status.keys())
      );
    }
  }
}
